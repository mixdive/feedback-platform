# Mixdive accepts exactly one deployment-time environment variable.
# Copy this file to `.env` and fill in your MongoDB connection string.
#
# Mongo must be a replica set (Mixdive uses transactions). For local
# development run `make dev-mongo` to start a single-node replica set
# on localhost:27017, which matches the default below.
#
# Atlas / Cloud Run: paste the full SRV connection string from Atlas,
# including credentials and the `?replicaSet=...` parameter.

MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
